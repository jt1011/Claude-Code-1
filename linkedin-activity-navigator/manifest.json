{
  "manifest_version": 3,
  "name": "LinkedIn Activity Navigator",
  "version": "1.0.0",
  "description": "Auto-scroll LinkedIn Activity pages to reach older posts. Set a target date, scroll safely, and avoid browser crashes. Read-only, no data collection.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/in/*/recent-activity/*",
        "https://www.linkedin.com/in/*/recent-activity/all/"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
