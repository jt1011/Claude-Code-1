{
  "manifest_version": 3,
  "name": "LinkedIn Engagement Highlighter",
  "version": "1.0.0",
  "description": "Visually highlights high-engagement LinkedIn posts based on visible engagement metrics. Fully client-side, no data collection.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/feed*", "https://www.linkedin.com/in/*", "https://www.linkedin.com/company/*", "https://www.linkedin.com/search/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
