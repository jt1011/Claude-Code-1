{
  "manifest_version": 3,
  "name": "Instagram Engagement Highlighter",
  "version": "1.0.0",
  "description": "Visually highlights high-engagement Instagram posts based on visible engagement metrics. Fully client-side, no data collection.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
